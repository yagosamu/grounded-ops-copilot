# Copy to .env and replace every value with a local-only credential.
POSTGRES_PASSWORD=replace-with-a-local-password
MINIO_ROOT_USER=replace-with-a-local-user
MINIO_ROOT_PASSWORD=replace-with-a-local-password
# API credentials remain empty until you configure an identity issuer and generation key.
# With them empty, /health/live works but /health/ready returns 503 and protected routes are absent.
OPENAI_API_KEY=
JWT_VERIFICATION_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
AUDIT_REDACTION_KEY=
